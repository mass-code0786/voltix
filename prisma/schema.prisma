generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum WalletType {
  SPOT
  FUTURES
  AI      @map("BITEX")
  FEE
}

enum WalletTransferStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum JournalStatus {
  PENDING
  POSTED
  REVERSED
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
  DETECTED
  CONFIRMING
  CONFIRMED
  CREDITED
  FAILED
  EXPIRED
}

enum DepositProvider {
  NOWPAYMENTS
}

enum WithdrawalStatus {
  PENDING
  COMPLETED
  APPROVED
  REJECTED
}

enum CodeStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  USED
  DELETED
}

enum TradeStatus {
  PENDING
  ACTIVE
  COMPLETED
  INCOME_CREDITED
  FAILED
}

enum TradeWindowSettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum IncomeType {
  DIRECT
  LEVEL
  MATCHING
  COPY_TRADE
  VIP_SALARY
  BOT_COMMISSION
  BONUS
}

enum PackageStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum SupportTicketStatus {
  OPEN
  PENDING
  CLOSED
}

enum NotificationType {
  DEPOSIT_STATUS
  WITHDRAWAL_STATUS
  COPY_TRADE_INCOME
  REFERRAL_INCOME
  AI_SUBSCRIPTION_PURCHASE
  AI_AUTO_TRADE
  NEW_DEPOSITOR_EXTRA_TRADE
  P2P_TRANSFER
  KYC_STATUS
  ADMIN_TRADE_CODE
  ADMIN_BROADCAST
  ADMIN_WALLET_ADJUSTMENT
  VIP_ACHIEVEMENT_REWARD
}

enum VipAchievementRewardStatus {
  PENDING
  CREDITED
  FAILED
}

enum AuditRole {
  USER
  ADMIN
  SYSTEM
}

enum AuditStatus {
  SUCCESS
  FAILED
  WARNING
}

enum VipSalaryPayoutStatus {
  PENDING
  PROCESSING
  CREDITED
  FAILED
}

model User {
  id                        String                  @id @default(cuid())
  email                     String                  @unique
  uid                       String                  @unique @db.VarChar(12)
  name                      String
  country                   String                  @default("United States")
  language                  String                  @default("en")
  profileImageUrl           String?
  passwordHash              String
  transactionPinHash        String?
  transactionPinSetAt       DateTime?
  vipRank                   String                  @default("VIP 0")
  vipAchievedAt             DateTime?
  vipUpdatedAt              DateTime?
  role                      Role                    @default(USER)
  status                    UserStatus              @default(ACTIVE)
  referredById              String?
  referredBy                User?                   @relation("ReferralTree", fields: [referredById], references: [id])
  referrals                 User[]                  @relation("ReferralTree")
  joinedAt                  DateTime                @default(now())
  extraTradeTrialEndsAt     DateTime
  permanentExtraTrade       Boolean                 @default(false)
  spotBalance               Decimal                 @default(0) @db.Decimal(36, 18)
  futuresBalance            Decimal                 @default(0) @db.Decimal(36, 18)
  aiWalletBalance           Decimal                 @default(0) @map("bitexBalance") @db.Decimal(36, 18)
  aiTradePrincipal          Decimal                 @default(0) @map("bitexPrincipal") @db.Decimal(36, 18)
  aiTradeProfitEarned       Decimal                 @default(0) @map("bitexIncomeEarned") @db.Decimal(36, 18)
  aiTradeTargetAmount       Decimal                 @default(0) @map("bitexTargetAmount") @db.Decimal(36, 18)
  aiTradeWithdrawalUnlocked Boolean                 @default(false) @map("bitexUnlocked")
  wallets                   WalletAccount[]
  externalWallets           ExternalWalletBinding[]
  walletTransfers           WalletTransfer[]
  p2pTransfersSent          P2PTransfer[]           @relation("P2PSender")
  p2pTransfersReceived      P2PTransfer[]           @relation("P2PReceiver")
  deposits                  Deposit[]
  withdrawals               Withdrawal[]
  walletAdjustments         AdminWalletAdjustment[] @relation("WalletAdjustmentUser")
  adminWalletAdjustments    AdminWalletAdjustment[] @relation("WalletAdjustmentAdmin")
  packages                  UserPackage[]
  aiSubscriptions           AiSubscription[]
  assignedCodes             TradeCode[]
  trades                    CopyTrade[]
  incomes                   Income[]
  vipSalaryPayouts          VipSalaryPayout[]
  vipAchievementRewards     VipAchievementReward[]
  kycRequests               KycRequest[]
  reviewedKycRequests       KycRequest[]            @relation("KycReviewer")
  supportTickets            SupportTicket[]
  notifications             Notification[]
  pushDevices               PushDevice[]
  auditLogs                 AuditLog[]              @relation("AuditActor")
  userAuditLogs             AuditLog[]              @relation("AuditUser")
  adminAuditLogs            AuditLog[]              @relation("AuditAdmin")
  sessions                  Session[]
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@index([referredById])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ExternalWalletBinding {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  network       String
  walletAddress String
  walletName    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, network])
  @@index([userId, createdAt])
}

model WalletTransfer {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id])
  fromWallet      WalletType
  toWallet        WalletType
  amount          Decimal              @db.Decimal(36, 18)
  feeAmount       Decimal              @default(0) @db.Decimal(36, 18)
  receivedAmount  Decimal              @db.Decimal(36, 18)
  reason          String
  status          WalletTransferStatus @default(PENDING)
  idempotencyKey  String               @unique
  ledgerJournalId String?              @unique
  failureReason   String?
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model P2PTransfer {
  id              String               @id @default(cuid())
  senderId        String
  sender          User                 @relation("P2PSender", fields: [senderId], references: [id])
  receiverId      String
  receiver        User                 @relation("P2PReceiver", fields: [receiverId], references: [id])
  assetId         String
  asset           Asset                @relation(fields: [assetId], references: [id])
  amount          Decimal              @db.Decimal(36, 18)
  note            String?
  status          WalletTransferStatus @default(PENDING)
  idempotencyKey  String               @unique
  ledgerJournalId String?              @unique
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@index([status, createdAt])
}

model AssetConversion {
  id                   String   @id @default(cuid())
  userId               String
  fromAssetId          String
  toAssetId            String
  fromSymbol           String
  toSymbol             String
  fromAmount           Decimal  @db.Decimal(36, 18)
  toAmount             Decimal  @db.Decimal(36, 18)
  price                Decimal  @db.Decimal(36, 18)
  idempotencyKey       String   @unique
  usdtLedgerJournalId  String?  @unique
  shineLedgerJournalId String?  @unique
  status               String   @default("COMPLETED")
  createdAt            DateTime @default(now())

  @@index([userId, createdAt])
  @@index([fromSymbol, toSymbol, createdAt])
}

model Asset {
  id                String                  @id @default(cuid())
  symbol            String                  @unique
  name              String
  decimals          Int
  enabled           Boolean                 @default(true)
  walletAccounts    WalletAccount[]
  deposits          Deposit[]
  withdrawals       Withdrawal[]
  walletAdjustments AdminWalletAdjustment[]
  p2pTransfers      P2PTransfer[]
}

model CoinMetadata {
  id            String   @id @default(cuid())
  symbol        String   @unique
  name          String
  pair          String   @unique
  logoUrl       String?
  localLogoPath String?
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(9999)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model WalletAccount {
  id        String        @id @default(cuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  assetId   String
  asset     Asset         @relation(fields: [assetId], references: [id])
  type      WalletType
  entries   LedgerEntry[]
  createdAt DateTime      @default(now())

  @@unique([userId, assetId, type])
  @@index([assetId, type])
}

model LedgerJournal {
  id              String           @id @default(cuid())
  referenceType   String
  referenceId     String
  idempotencyKey  String           @unique
  memo            String
  status          JournalStatus    @default(PENDING)
  entries         LedgerEntry[]
  aiSubscriptions AiSubscription[]
  postedAt        DateTime?
  createdAt       DateTime         @default(now())

  @@unique([referenceType, referenceId])
}

model LedgerEntry {
  id        String          @id @default(cuid())
  journalId String
  journal   LedgerJournal   @relation(fields: [journalId], references: [id])
  accountId String
  account   WalletAccount   @relation(fields: [accountId], references: [id])
  direction LedgerDirection
  amount    Decimal         @db.Decimal(36, 18)
  createdAt DateTime        @default(now())

  @@index([accountId, createdAt])
}

model ChainNetwork {
  id                    String       @id @default(cuid())
  key                   String       @unique
  name                  String
  requiredConfirmations Int
  enabled               Boolean      @default(true)
  deposits              Deposit[]
  withdrawals           Withdrawal[]
}

model Deposit {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id])
  assetId            String
  asset              Asset           @relation(fields: [assetId], references: [id])
  networkId          String
  network            ChainNetwork    @relation(fields: [networkId], references: [id])
  provider           DepositProvider @default(NOWPAYMENTS)
  providerPaymentId  String?         @unique
  providerInvoiceId  String?         @unique
  providerPaymentUrl String?
  payCurrency        String?
  payAddress         String?
  paymentStatus      String?
  actuallyPaid       Decimal?        @db.Decimal(36, 18)
  outcomeAmount      Decimal?        @db.Decimal(36, 18)
  rawWebhookJson     Json?
  webhookReceivedAt  DateTime?
  txHash             String?
  eventIndex         Int             @default(0)
  amount             Decimal         @db.Decimal(36, 18)
  blockNumber        BigInt?
  confirmations      Int             @default(0)
  status             DepositStatus   @default(PENDING)
  creditedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([networkId, txHash, eventIndex])
  @@index([status, createdAt])
  @@index([provider, paymentStatus, createdAt])
}

model Withdrawal {
  id                         String           @id @default(cuid())
  userId                     String
  user                       User             @relation(fields: [userId], references: [id])
  assetId                    String
  asset                      Asset            @relation(fields: [assetId], references: [id])
  networkId                  String
  network                    ChainNetwork     @relation(fields: [networkId], references: [id])
  walletType                 WalletType
  address                    String
  amount                     Decimal          @db.Decimal(36, 18)
  feeAmount                  Decimal          @default(0) @db.Decimal(36, 18)
  receivableAmount           Decimal          @db.Decimal(36, 18)
  eligibilityStatus          String?
  capitalAmount              Decimal          @default(0) @db.Decimal(36, 18)
  earnedProfit               Decimal          @default(0) @db.Decimal(36, 18)
  requiredProfit             Decimal          @default(0) @db.Decimal(36, 18)
  completedPercentage        Decimal          @default(0) @db.Decimal(8, 4)
  earlyWithdrawal            Boolean          @default(false)
  earlyWithdrawalCharge      Decimal          @default(0) @db.Decimal(36, 18)
  percentageFee              Decimal          @default(0) @db.Decimal(36, 18)
  fixedFee                   Decimal          @default(0) @db.Decimal(36, 18)
  totalCharges               Decimal          @default(0) @db.Decimal(36, 18)
  netWithdrawalAmount        Decimal          @default(0) @db.Decimal(36, 18)
  earlyWithdrawalConfirmedAt DateTime?
  idempotencyKey             String           @unique
  ledgerJournalId            String?          @unique
  txHash                     String?
  status                     WithdrawalStatus @default(PENDING)
  adminActionBy              String?
  adminActionAt              DateTime?
  rejectionReason            String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AdminWalletAdjustment {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation("WalletAdjustmentUser", fields: [userId], references: [id])
  adminId         String
  admin           User       @relation("WalletAdjustmentAdmin", fields: [adminId], references: [id])
  assetId         String
  asset           Asset      @relation(fields: [assetId], references: [id])
  walletType      WalletType
  action          String
  amount          Decimal    @db.Decimal(36, 18)
  reason          String
  idempotencyKey  String     @unique
  status          String     @default("SUCCESS")
  ledgerJournalId String?    @unique
  depositId       String?
  createdAt       DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
}

model MlmPlan {
  id                    String        @id @default(cuid())
  name                  String
  version               Int
  packageAmountUsd      Decimal       @db.Decimal(18, 2)
  directPercent         Decimal       @db.Decimal(5, 2)
  matchingPercent       Decimal       @db.Decimal(5, 2)
  levelPercents         Json
  minQualifiedDirectUsd Decimal       @default(100) @db.Decimal(18, 2)
  active                Boolean       @default(true)
  packages              UserPackage[]
  createdAt             DateTime      @default(now())

  @@unique([name, version])
}

model UserPackage {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  planId      String
  plan        MlmPlan       @relation(fields: [planId], references: [id])
  amountUsd   Decimal       @db.Decimal(18, 2)
  status      PackageStatus @default(ACTIVE)
  purchasedAt DateTime      @default(now())
  expiresAt   DateTime?

  @@index([userId, status])
}

model AiSubscription {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  amountUsd       Decimal       @db.Decimal(18, 2)
  startsAt        DateTime      @default(now())
  expiresAt       DateTime
  active          Boolean       @default(true)
  ledgerJournalId String        @unique
  ledgerJournal   LedgerJournal @relation(fields: [ledgerJournalId], references: [id])
  createdAt       DateTime      @default(now())

  @@index([userId, active, expiresAt])
  @@index([expiresAt])
}

model KycRequest {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  fullName           String
  dateOfBirth        DateTime?
  country            String?
  address            String?
  governmentIdType   String
  governmentIdNumber String
  frontIdImageUrl    String?
  backIdImageUrl     String?
  selfieImageUrl     String?
  status             KycStatus @default(UNDER_REVIEW)
  rejectionReason    String?
  submittedAt        DateTime  @default(now())
  reviewedAt         DateTime?
  reviewedById       String?
  reviewedBy         User?     @relation("KycReviewer", fields: [reviewedById], references: [id])
  updatedAt          DateTime  @updatedAt

  @@index([userId, submittedAt])
  @@index([status, submittedAt])
}

model SupportTicket {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id])
  subject        String
  message        String
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?
  status         SupportTicketStatus @default(OPEN)
  adminReply     String?
  repliedById    String?
  repliedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  message       String
  metadata      Json?
  settlementKey String?          @unique
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@index([type, createdAt])
}

model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  appVersion String?
  deviceId   String?
  enabled    Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, enabled])
  @@index([platform, enabled])
}

model TradeSlot {
  id              String      @id @default(cuid())
  label           String
  utcTime         String
  durationMinutes Int         @default(30)
  creditDelayMins Int         @default(10)
  enabled         Boolean     @default(true)
  codes           TradeCode[]
  trades          CopyTrade[]
}

model TradeCode {
  id                 String      @id @default(cuid())
  code               String      @unique @db.VarChar(6)
  vipRank            String      @default("NONE")
  returnPercent      Decimal     @db.Decimal(5, 2)
  assignedUserId     String?
  assignedUser       User?       @relation(fields: [assignedUserId], references: [id])
  slotId             String?
  slot               TradeSlot?  @relation(fields: [slotId], references: [id])
  status             CodeStatus  @default(ACTIVE)
  expiresAt          DateTime?
  tradeWindowMinutes Int         @default(10)
  maxUsage           Int         @default(1)
  usedCount          Int         @default(0)
  trades             CopyTrade[]
  createdBy          String
  createdAt          DateTime    @default(now())

  @@index([status, expiresAt])
  @@index([createdBy, createdAt])
}

model CopyTrade {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id])
  codeId           String?
  code             TradeCode?  @relation(fields: [codeId], references: [id])
  slotId           String
  slot             TradeSlot   @relation(fields: [slotId], references: [id])
  source           String      @default("MANUAL")
  pair             String?
  promotionDay     Int?
  walletSnapshotAtTrade Decimal?    @db.Decimal(36, 18)
  selectedRate     Decimal?    @db.Decimal(10, 6)
  calculatedProfit Decimal?    @db.Decimal(36, 18)
  idempotencyKey   String?     @unique
  principalAmount  Decimal     @db.Decimal(36, 18)
  returnPercent    Decimal     @db.Decimal(10, 6)
  incomeAmount     Decimal?    @db.Decimal(36, 18)
  status           TradeStatus @default(PENDING)
  startedAt        DateTime    @db.Timestamptz(3)
  windowStartAt    DateTime?   @db.Timestamptz(3)
  windowCloseAt    DateTime?   @db.Timestamptz(3)
  completesAt      DateTime    @db.Timestamptz(3)
  creditDueAt      DateTime    @db.Timestamptz(3)
  completedAt      DateTime?   @db.Timestamptz(3)
  incomeCreditedAt DateTime?   @db.Timestamptz(3)
  failureReason    String?
  income           Income?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status, completesAt])
  @@index([status, creditDueAt])
  @@index([userId, startedAt])
  @@index([userId, slotId, windowStartAt, windowCloseAt])
  @@index([slotId, windowStartAt, creditDueAt, status])
  @@index([codeId])
  @@index([source, startedAt])
  @@index([source, promotionDay, status])
}

model TradeWindowSettlement {
  id                  String                      @id @default(cuid())
  occurrenceKey       String                      @unique
  slotId              String
  windowStartAt       DateTime                     @db.Timestamptz(3)
  windowCloseAt       DateTime                     @db.Timestamptz(3)
  settlementDueAt     DateTime                     @db.Timestamptz(3)
  status              TradeWindowSettlementStatus @default(PENDING)
  totalTrades         Int                         @default(0)
  settledTrades       Int                         @default(0)
  failedTrades        Int                         @default(0)
  attempts            Int                         @default(0)
  processingStartedAt DateTime?                    @db.Timestamptz(3)
  completedAt         DateTime?                    @db.Timestamptz(3)
  leaseExpiresAt      DateTime?                    @db.Timestamptz(3)
  lastError           String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@index([status, settlementDueAt])
  @@index([leaseExpiresAt])
}

model ManualTradeSignal {
  id              String   @id @default(cuid())
  occurrenceKey   String   @unique
  slotId          String
  windowLabel     String
  windowStartAt   DateTime @db.Timestamptz(3)
  windowCloseAt   DateTime @db.Timestamptz(3)
  settlementDueAt DateTime @db.Timestamptz(3)
  pairs           Json
  recommendedPair String
  createdAt       DateTime @default(now())

  @@index([slotId, windowStartAt])
}

model Income {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  type            IncomeType
  sourceType      String
  sourceId        String
  amount          Decimal    @db.Decimal(36, 18)
  copyTradeId     String?    @unique
  copyTrade       CopyTrade? @relation(fields: [copyTradeId], references: [id])
  ledgerJournalId String     @unique
  createdAt       DateTime   @default(now())

  @@unique([userId, type, sourceType, sourceId])
  @@index([userId, createdAt])
}

model VipSalaryPayout {
  id                   String                @id @default(cuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id])
  vipRank              String
  grossSalary          Decimal               @db.Decimal(18, 2)
  payoutDate           DateTime              @db.Date
  walletType           WalletType            @default(SPOT)
  transactionReference String                @unique
  ledgerJournalId      String?               @unique
  status               VipSalaryPayoutStatus @default(PENDING)
  failureReason        String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  creditedAt           DateTime?

  @@unique([userId, payoutDate])
  @@index([status, payoutDate])
}

model VipAchievementReward {
  id              String                     @id @default(cuid())
  userId          String
  user            User                       @relation(fields: [userId], references: [id])
  vipRank         Int
  rewardAmount    Decimal                    @db.Decimal(18, 2)
  walletType      WalletType                 @default(SPOT)
  transactionId   String?                    @unique
  status          VipAchievementRewardStatus @default(PENDING)
  uniqueReference String                     @unique
  previousRank    String
  newRank         String
  achievedAt      DateTime
  creditedAt      DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([userId, vipRank])
  @@index([status, achievedAt])
}

model AuditLog {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  userId        String?
  user          User?       @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)
  adminId       String?
  admin         User?       @relation("AuditAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  role          AuditRole   @default(SYSTEM)
  action        String
  module        String      @default("SYSTEM")
  description   String      @default("")
  status        AuditStatus @default(SUCCESS)
  ipAddress     String?
  country       String?
  city          String?
  userAgent     String?
  device        String?
  browser       String?
  os            String?
  requestMethod String?
  requestPath   String?
  requestId     String?
  oldValue      Json?
  newValue      Json?
  metadata      Json?
  errorMessage  String?
  durationMs    Int?
  archivedAt    DateTime?
  archivedById  String?
  actorId       String?
  actor         User?       @relation("AuditActor", fields: [actorId], references: [id])
  actorType     String      @default("SYSTEM")
  entityType    String      @default("AuditLog")
  entityId      String      @default("")

  @@index([createdAt])
  @@index([action])
  @@index([module])
  @@index([userId])
  @@index([adminId])
  @@index([status])
  @@index([entityType, entityId])
}
